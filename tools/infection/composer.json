{
  "config": {
    "platform": {
      "php": "8.2.99"
    },
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "require": {
    "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "laminas/laminas-translator": "^1.3 || ^2.0",
    "psr/container": "^1.1.2 || ^2.0.2",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "require-dev": {
    "laminas/laminas-servicemanager": "^4.5.1",
    "laminas/laminas-diactoros": "^3.8",
    "psalm/plugin-phpunit": "^0.19.7",
    "roave/infection-static-analysis-plugin": "^1.40",
    "vimeo/psalm": "^6.16.1"
  },
  "autoload": {
    "psr-4": {
      "Laminas\\Router\\": "../../src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LaminasTest\\Router\\": "../../test/"
    }
  }
}
