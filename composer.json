{
    "name": "laminas/laminas-router",
    "description": "Flexible routing system for HTTP and console applications",
    "license": "BSD-3-Clause",
    "keywords": [
        "laminas",
        "routing"
    ],
    "homepage": "https://laminas.dev",
    "support": {
        "docs": "https://docs.laminas.dev/laminas-router/",
        "issues": "https://github.com/laminas/laminas-router/issues",
        "source": "https://github.com/laminas/laminas-router",
        "rss": "https://github.com/laminas/laminas-router/releases.atom",
        "chat": "https://laminas.dev/chat",
        "forum": "https://discourse.laminas.dev"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.99"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laminas": {
            "config-provider": "Laminas\\Router\\ConfigProvider"
        }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "laminas/laminas-servicemanager": "^4.5.0",
        "laminas/laminas-stdlib": "^3.21.0",
        "laminas/laminas-translator": "^1.3",
        "psr/container": "^1.1.2 || ^2.0.2",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "~3.1.0",
        "laminas/laminas-diactoros": "^3.8",
        "phpunit/phpunit": "^11.5.55",
        "psalm/plugin-phpunit": "^0.19.5",
        "vimeo/psalm": "^6.15.1"
    },
    "suggest": {
        "laminas/laminas-i18n": "^2.15.0 if defining translatable HTTP path segments"
    },
    "autoload": {
        "psr-4": {
            "Laminas\\Router\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaminasTest\\Router\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "psalm --shepherd --stats",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    },
    "conflict": {
        "zendframework/zend-router": "*"
    }
}
